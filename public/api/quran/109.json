{"chapter":{"id":109,"name_simple":"Al-Kafirun","name_arabic":"الكافرون","verses_count":6,"revelation_place":"makkah","translated_name":{"language_name":"english","name":"The Disbelievers"}},"verses":[{"id":6208,"verse_number":1,"verse_key":"109:1","text_uthmani":" قُلْ يَـٰٓأَيُّهَا ٱلْكَـٰفِرُونَ","juz_number":30,"page_number":603,"translations":[{"resource_id":20,"text":"Say, \"O disbelievers,"},{"resource_id":133,"text":"(நபியே! நிராகரிக்கும் மக்களை நோக்கி) கூறுவீராக: நிராகரிப்பவர்களே!"}]},{"id":6209,"verse_number":2,"verse_key":"109:2","text_uthmani":"لَآ أَعْبُدُ مَا تَعْبُدُونَ","juz_number":30,"page_number":603,"translations":[{"resource_id":20,"text":"I do not worship what you worship."},{"resource_id":133,"text":"நீங்கள் வணங்குபவற்றை நான் வணங்கமாட்டேன்."}]},{"id":6210,"verse_number":3,"verse_key":"109:3","text_uthmani":"وَلَآ أَنتُمْ عَـٰبِدُونَ مَآ أَعْبُدُ","juz_number":30,"page_number":603,"translations":[{"resource_id":20,"text":"Nor are you worshippers of what I worship."},{"resource_id":133,"text":"நான் வணங்குபவனை நீங்கள் வணங்கவில்லை."}]},{"id":6211,"verse_number":4,"verse_key":"109:4","text_uthmani":"وَلَآ أَنَا۠ عَابِدٌ مَّا عَبَدتُّمْ","juz_number":30,"page_number":603,"translations":[{"resource_id":20,"text":"Nor will I be a worshipper of what you worship."},{"resource_id":133,"text":"(அவ்வாறே) இனியும் நீங்கள் வணங்குபவற்றை நான் வணங்குபவன் அல்லன்."}]},{"id":6212,"verse_number":5,"verse_key":"109:5","text_uthmani":"وَلَآ أَنتُمْ عَـٰبِدُونَ مَآ أَعْبُدُ","juz_number":30,"page_number":603,"translations":[{"resource_id":20,"text":"Nor will you be worshippers of what I worship."},{"resource_id":133,"text":"நான் வணங்குபவனை இனி நீங்களும் வணங்குபவர்கள் அல்லர்."}]},{"id":6213,"verse_number":6,"verse_key":"109:6","text_uthmani":"لَكُمْ دِينُكُمْ وَلِىَ دِينِ","juz_number":30,"page_number":603,"translations":[{"resource_id":20,"text":"For you is your religion, and for me is my religion.\""},{"resource_id":133,"text":"உங்கள் (செயலுக்குரிய) கூலி உங்களுக்கும்; என் (செயலுக்குரிய) கூலி எனக்கும் (கிடைக்கும்)."}]}],"pagination":{"total_records":6,"total_pages":1,"current_page":1}}