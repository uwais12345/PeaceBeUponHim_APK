{"chapter":{"id":114,"name_simple":"An-Nas","name_arabic":"الناس","verses_count":6,"revelation_place":"makkah","translated_name":{"language_name":"english","name":"Mankind"}},"verses":[{"id":6231,"verse_number":1,"verse_key":"114:1","text_uthmani":" قُلْ أَعُوذُ بِرَبِّ ٱلنَّاسِ","juz_number":30,"page_number":604,"translations":[{"resource_id":20,"text":"Say, \"I seek refuge in the Lord of mankind,"},{"resource_id":133,"text":"(நபியே! பிரார்த்தனை செய்து) கூறுவீராக: மனிதர்களின் இறைவனிடம் நான் பாதுகாப்பைக் கோருகிறேன்."}]},{"id":6232,"verse_number":2,"verse_key":"114:2","text_uthmani":"مَلِكِ ٱلنَّاسِ","juz_number":30,"page_number":604,"translations":[{"resource_id":20,"text":"The Sovereign of mankind,"},{"resource_id":133,"text":"(அவன்தான்) மனிதர்களின் (உண்மையான) அரசன்."}]},{"id":6233,"verse_number":3,"verse_key":"114:3","text_uthmani":"إِلَـٰهِ ٱلنَّاسِ","juz_number":30,"page_number":604,"translations":[{"resource_id":20,"text":"The God of mankind,"},{"resource_id":133,"text":"(அவனே) மனிதர்களின் வணக்கத்திற்குரிய உண்மையான இறைவன்."}]},{"id":6234,"verse_number":4,"verse_key":"114:4","text_uthmani":"مِن شَرِّ ٱلْوَسْوَاسِ ٱلْخَنَّاسِ","juz_number":30,"page_number":604,"translations":[{"resource_id":20,"text":"From the evil of the retreating whisperer -"},{"resource_id":133,"text":"5. மனிதர்களுடைய உள்ளங்களில் (வீணான) சந்தேகங்களை உண்டு பண்ணிவிட்டு, மறைந்து கொள்ளும் விஷமிகளின் தீங்கை விட்டும் (பாதுகாக்கக் கோருகிறேன்)."}]},{"id":6235,"verse_number":5,"verse_key":"114:5","text_uthmani":"ٱلَّذِى يُوَسْوِسُ فِى صُدُورِ ٱلنَّاسِ","juz_number":30,"page_number":604,"translations":[{"resource_id":20,"text":"Who whispers [evil] into the breasts of mankind -"},{"resource_id":133,"text":"5. மனிதர்களுடைய உள்ளங்களில் (வீணான) சந்தேகங்களை உண்டு பண்ணிவிட்டு, மறைந்து கொள்ளும் விஷமிகளின் தீங்கை விட்டும் (பாதுகாக்கக் கோருகிறேன்)."}]},{"id":6236,"verse_number":6,"verse_key":"114:6","text_uthmani":"مِنَ ٱلْجِنَّةِ وَٱلنَّاسِ","juz_number":30,"page_number":604,"translations":[{"resource_id":20,"text":"From among the jinn and mankind\"."},{"resource_id":133,"text":"(அத்தகைய விஷமிகள்) ஜின்களிலும் இருக்கின்றனர்; மனிதர்களிலும் இருக்கின்றனர்."}]}],"pagination":{"total_records":6,"total_pages":1,"current_page":1}}