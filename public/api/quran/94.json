{"chapter":{"id":94,"name_simple":"Ash-Sharh","name_arabic":"الشرح","verses_count":8,"revelation_place":"makkah","translated_name":{"language_name":"english","name":"The Relief"}},"verses":[{"id":6091,"verse_number":1,"verse_key":"94:1","text_uthmani":" أَلَمْ نَشْرَحْ لَكَ صَدْرَكَ","juz_number":30,"page_number":596,"translations":[{"resource_id":20,"text":"Did We not expand for you, [O Muḥammad], your breast?"},{"resource_id":133,"text":"(நபியே!) உமது உள்ளத்தை நாம் உமக்கு விரிவாக்கவில்லையா?"}]},{"id":6092,"verse_number":2,"verse_key":"94:2","text_uthmani":"وَوَضَعْنَا عَنكَ وِزْرَكَ","juz_number":30,"page_number":596,"translations":[{"resource_id":20,"text":"And We removed from you your burden"},{"resource_id":133,"text":"உமது சுமையையும் உம்மைவிட்டும் நாம் இறக்கிவிட்டோம்."}]},{"id":6093,"verse_number":3,"verse_key":"94:3","text_uthmani":"ٱلَّذِىٓ أَنقَضَ ظَهْرَكَ","juz_number":30,"page_number":596,"translations":[{"resource_id":20,"text":"Which had weighed upon your back"},{"resource_id":133,"text":"அது, உமது இடுப்பையே முறித்துக் கொண்டிருந்தது."}]},{"id":6094,"verse_number":4,"verse_key":"94:4","text_uthmani":"وَرَفَعْنَا لَكَ ذِكْرَكَ","juz_number":30,"page_number":596,"translations":[{"resource_id":20,"text":"And raised high for you your repute."},{"resource_id":133,"text":"உமது கீர்த்தியையும் நாம் உயர்த்தினோம்."}]},{"id":6095,"verse_number":5,"verse_key":"94:5","text_uthmani":"فَإِنَّ مَعَ ٱلْعُسْرِ يُسْرًا","juz_number":30,"page_number":596,"translations":[{"resource_id":20,"text":"For indeed, with hardship [will be] ease [i.e., relief]."},{"resource_id":133,"text":"நிச்சயமாக சிரமத்துடன் சௌகரியம் இருக்கிறது."}]},{"id":6096,"verse_number":6,"verse_key":"94:6","text_uthmani":"إِنَّ مَعَ ٱلْعُسْرِ يُسْرًا","juz_number":30,"page_number":596,"translations":[{"resource_id":20,"text":"Indeed, with hardship [will be] ease."},{"resource_id":133,"text":"மெய்யாகவே சிரமத்துடன் சௌகரியம் இருக்கிறது."}]},{"id":6097,"verse_number":7,"verse_key":"94:7","text_uthmani":"فَإِذَا فَرَغْتَ فَٱنصَبْ","juz_number":30,"page_number":596,"translations":[{"resource_id":20,"text":"So when you have finished [your duties], then stand up [for worship]."},{"resource_id":133,"text":"ஆகவே, (மார்க்கப் பிரச்சாரத்திலிருந்து) நீர் விடுபட்டதும், (இறைவனை வணங்குவதற்கு) சிரத்தை எடுப்பீராக."}]},{"id":6098,"verse_number":8,"verse_key":"94:8","text_uthmani":"وَإِلَىٰ رَبِّكَ فَٱرْغَب","juz_number":30,"page_number":596,"translations":[{"resource_id":20,"text":"And to your Lord direct [your] longing."},{"resource_id":133,"text":"மேலும், (துன்பத்திலும் இன்பத்திலும்) உமது இறைவனையே நீர் நோக்கி நிற்பீராக!"}]}],"pagination":{"total_records":8,"total_pages":1,"current_page":1}}