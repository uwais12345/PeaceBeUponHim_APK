{"chapter":{"id":101,"name_simple":"Al-Qari'ah","name_arabic":"القارعة","verses_count":11,"revelation_place":"makkah","translated_name":{"language_name":"english","name":"The Calamity"}},"verses":[{"id":6158,"verse_number":1,"verse_key":"101:1","text_uthmani":" ٱلْقَارِعَةُ","juz_number":30,"page_number":600,"translations":[{"resource_id":20,"text":"The Striking Calamity -"},{"resource_id":133,"text":"(மரணித்தவர்களையும்) திடுக்கிடச் செய்யும் சம்பவம்!"}]},{"id":6159,"verse_number":2,"verse_key":"101:2","text_uthmani":"مَا ٱلْقَارِعَةُ","juz_number":30,"page_number":600,"translations":[{"resource_id":20,"text":"What is the Striking Calamity?"},{"resource_id":133,"text":"(அத்தகைய) திடுக்கிடச் செய்யும் சம்பவம் என்ன?"}]},{"id":6160,"verse_number":3,"verse_key":"101:3","text_uthmani":"وَمَآ أَدْرَىٰكَ مَا ٱلْقَارِعَةُ","juz_number":30,"page_number":600,"translations":[{"resource_id":20,"text":"And what can make you know what is the Striking Calamity?"},{"resource_id":133,"text":"(நபியே!) திடுக்கிடச் செய்யும் சம்பவம் இன்னதென்று நீர்அறிவீரா?"}]},{"id":6161,"verse_number":4,"verse_key":"101:4","text_uthmani":"يَوْمَ يَكُونُ ٱلنَّاسُ كَٱلْفَرَاشِ ٱلْمَبْثُوثِ","juz_number":30,"page_number":600,"translations":[{"resource_id":20,"text":"It is the Day when people will be like moths, dispersed,"},{"resource_id":133,"text":"அந்நாளில் மனிதர்கள் சிதறிக்கிடக்கும் ஈசல்களைப் போல் ஆகிவிடுவார்கள்."}]},{"id":6162,"verse_number":5,"verse_key":"101:5","text_uthmani":"وَتَكُونُ ٱلْجِبَالُ كَٱلْعِهْنِ ٱلْمَنفُوشِ","juz_number":30,"page_number":600,"translations":[{"resource_id":20,"text":"And the mountains will be like wool, fluffed up."},{"resource_id":133,"text":"கொட்டப்பட்ட பஞ்சுகளைப்போல் மலைகள் ஆகிவிடும்."}]},{"id":6163,"verse_number":6,"verse_key":"101:6","text_uthmani":"فَأَمَّا مَن ثَقُلَتْ مَوَٰزِينُهُۥ","juz_number":30,"page_number":600,"translations":[{"resource_id":20,"text":"Then as for one whose scales are heavy [with good deeds],"},{"resource_id":133,"text":"எவருடைய (நன்மையின்) எடை கனத்ததோ,"}]},{"id":6164,"verse_number":7,"verse_key":"101:7","text_uthmani":"فَهُوَ فِى عِيشَةٍ رَّاضِيَةٍ","juz_number":30,"page_number":600,"translations":[{"resource_id":20,"text":"He will be in a pleasant life."},{"resource_id":133,"text":"அவர் திருப்தியுள்ள வாழ்க்கையில் (சுகமாக) வாழ்ந்திருப்பார்."}]},{"id":6165,"verse_number":8,"verse_key":"101:8","text_uthmani":"وَأَمَّا مَنْ خَفَّتْ مَوَٰزِينُهُۥ","juz_number":30,"page_number":600,"translations":[{"resource_id":20,"text":"But as for one whose scales are light,"},{"resource_id":133,"text":"எவனுடைய (நன்மையின்) எடை இலேசாகி(ப் பாவ எடை கனத்து) விட்டதோ,"}]},{"id":6166,"verse_number":9,"verse_key":"101:9","text_uthmani":"فَأُمُّهُۥ هَاوِيَةٌ","juz_number":30,"page_number":600,"translations":[{"resource_id":20,"text":"His refuge will be an abyss."},{"resource_id":133,"text":"அவன் தங்குமிடம் ஹாவியாதான்."}]},{"id":6167,"verse_number":10,"verse_key":"101:10","text_uthmani":"وَمَآ أَدْرَىٰكَ مَا هِيَهْ","juz_number":30,"page_number":600,"translations":[{"resource_id":20,"text":"And what can make you know what that is?"},{"resource_id":133,"text":"அந்த ஹாவியா இன்னதென்று (நபியே!) நீர் அறிவீரா?"}]},{"id":6168,"verse_number":11,"verse_key":"101:11","text_uthmani":"نَارٌ حَامِيَةٌۢ","juz_number":30,"page_number":600,"translations":[{"resource_id":20,"text":"It is a Fire, intensely hot."},{"resource_id":133,"text":"(அதுதான்) கனிந்து கொண்டிருக்கும் (நரக) நெருப்பாகும்."}]}],"pagination":{"total_records":11,"total_pages":1,"current_page":1}}