{"chapter":{"id":107,"name_simple":"Al-Ma'un","name_arabic":"الماعون","verses_count":7,"revelation_place":"makkah","translated_name":{"language_name":"english","name":"The Small kindnesses"}},"verses":[{"id":6198,"verse_number":1,"verse_key":"107:1","text_uthmani":" أَرَءَيْتَ ٱلَّذِى يُكَذِّبُ بِٱلدِّينِ","juz_number":30,"page_number":602,"translations":[{"resource_id":20,"text":"Have you seen the one who denies the Recompense?"},{"resource_id":133,"text":"(நபியே!) கூலி கொடுக்கும் நாளைப் பொய்யாக்குபவனை நீர் (கவனித்துப்) பார்த்தீரா?"}]},{"id":6199,"verse_number":2,"verse_key":"107:2","text_uthmani":"فَذَٰلِكَ ٱلَّذِى يَدُعُّ ٱلْيَتِيمَ","juz_number":30,"page_number":602,"translations":[{"resource_id":20,"text":"For that is the one who drives away the orphan"},{"resource_id":133,"text":"(ஆதரவற்ற) அநாதைகளை வெருட்டுபவன் அவன்தான்."}]},{"id":6200,"verse_number":3,"verse_key":"107:3","text_uthmani":"وَلَا يَحُضُّ عَلَىٰ طَعَامِ ٱلْمِسْكِينِ","juz_number":30,"page_number":602,"translations":[{"resource_id":20,"text":"And does not encourage the feeding of the poor."},{"resource_id":133,"text":"அவன் ஏழைகளுக்கு (உணவளிக்காததுடன்) உணவளிக்கும்படி (பிறரைத்) தூண்டுவதுமில்லை."}]},{"id":6201,"verse_number":4,"verse_key":"107:4","text_uthmani":"فَوَيْلٌ لِّلْمُصَلِّينَ","juz_number":30,"page_number":602,"translations":[{"resource_id":20,"text":"So woe to those who pray"},{"resource_id":133,"text":"(கவனமற்ற) தொழுகையாளிகளுக்கும் கேடுதான்."}]},{"id":6202,"verse_number":5,"verse_key":"107:5","text_uthmani":"ٱلَّذِينَ هُمْ عَن صَلَاتِهِمْ سَاهُونَ","juz_number":30,"page_number":602,"translations":[{"resource_id":20,"text":"[But] who are heedless of their prayer -"},{"resource_id":133,"text":"அவர்கள் தங்கள் தொழுகைகளை விட்டும் மறந்தவர்களாக இருக்கிறார்கள்."}]},{"id":6203,"verse_number":6,"verse_key":"107:6","text_uthmani":"ٱلَّذِينَ هُمْ يُرَآءُونَ","juz_number":30,"page_number":602,"translations":[{"resource_id":20,"text":"Those who make show [of their deeds]"},{"resource_id":133,"text":"(மேலும்,) அவர்கள் (தொழுதபோதிலும் மக்களுக்குக்) காண்பிக்கவே தொழுகிறார்கள்."}]},{"id":6204,"verse_number":7,"verse_key":"107:7","text_uthmani":"وَيَمْنَعُونَ ٱلْمَاعُونَ","juz_number":30,"page_number":602,"translations":[{"resource_id":20,"text":"And withhold [simple] assistance."},{"resource_id":133,"text":"(மேலும், ஊசி போன்ற) அற்பப் பொருளையும் (இரவல் கொடுக்காது) தடுத்துக் கொள்கிறார்கள்."}]}],"pagination":{"total_records":7,"total_pages":1,"current_page":1}}